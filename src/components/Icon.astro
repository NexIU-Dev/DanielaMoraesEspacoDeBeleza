---
interface Props {
  name: 'chat' | 'down' | 'up' | 'plus' | 'star' | 'pin';
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill={name === 'star' ? 'currentColor' : 'none'} stroke={name === 'star' ? 'none' : 'currentColor'} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'chat' && <>
    <path d="M20 11.5a8 8 0 0 1-8 8 8.2 8.2 0 0 1-3.4-.75L4 20l1.25-4.6A8 8 0 1 1 20 11.5Z" />
    <path d="M8.7 8.3c-.35.55-.48 1.08-.18 1.72a7.6 7.6 0 0 0 3.47 3.53c.63.28 1.16.18 1.7-.2l.73-.55-1.88-1.07-.73.52a5.1 5.1 0 0 1-1.92-1.97l.5-.68-1.12-1.86-.57.64Z" stroke-width="1.2" />
  </>}
  {name === 'down' && <path d="M12 3.5v16m-5.5-5.5L12 19.5l5.5-5.5" />}
  {name === 'up' && <path d="M12 20.5v-16m-5.5 5.5L12 4.5l5.5 5.5" />}
  {name === 'plus' && <path d="M12 4.5v15M4.5 12h15" />}
  {name === 'star' && <path d="m12 2.5 2.86 5.8 6.4.93-4.63 4.52 1.1 6.37L12 17.1l-5.73 3.02 1.1-6.37L2.74 9.23l6.4-.93L12 2.5Z" />}
  {name === 'pin' && <>
    <path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" />
    <circle cx="12" cy="10" r="2.35" />
  </>}
</svg>
